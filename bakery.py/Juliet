# ============================================================
# CHOOSE QUANTITY
# ============================================================

def choose_quantity():

    while True:
        try:
            quantity = int(input("Enter quantity: "))

            if quantity > 0:
                return quantity

            print("Quantity must be at least 1.")

        except ValueError:
            print("Please enter a valid number.")


# ============================================================
# DISPLAY CART
# ============================================================

def print_cart_so_far(order_items):

    running_total = sum(
        subtotal for _, _, _, subtotal in order_items
    )

    print()
    print("--- Cart so far ---")

    if not order_items:
        print("Your cart is empty.")
    else:
        for item, price, quantity, subtotal in order_items:
            print(
                f"{quantity} x {item} @ ₦{price:,} "
                f"= ₦{subtotal:,}"
            )

    print("--------------------------------")
    print(f"Running total: ₦{running_total:,}")


# ============================================================
# BUILD ORDER
# ============================================================

def build_order():

    """
    Allows the customer to:
    - Choose an item
    - Enter quantity
    - Add another item
    - Automatically combine duplicate items
    """

    order_items = []

    while True:

        item, price = choose_item()

        quantity = choose_quantity()

        # Check whether the item is already in the cart.
        existing_index = None

        for i, (existing_item, _, _, _) in enumerate(order_items):

            if existing_item == item:
                existing_index = i
                break

        # If item already exists, increase quantity.
        if existing_index is not None:

            _, _, old_quantity, _ = order_items[existing_index]

            new_quantity = old_quantity + quantity

            new_subtotal = price * new_quantity

            order_items[existing_index] = (
                item,
                price,
                new_quantity,
                new_subtotal
            )

            print()
            print(
                f"Updated: {item} quantity is now "
                f"{new_quantity} "
                f"(₦{new_subtotal:,})"
            )

        # Otherwise add a new item.
        else:

            subtotal = price * quantity

            order_items.append(
                (item, price, quantity, subtotal)
            )

        print_cart_so_far(order_items)

        # Ask if customer wants another item.
        while True:

            add_more = input(
                "Add another item? (yes/no): "
            ).strip().lower()

            if add_more in ("yes", "no"):
                break

            print("Please answer yes or no.")

        if add_more == "no":
            break

        print()

    return order_items


# ============================================================
# REMOVE ITEM
# ============================================================

def remove_item(order_items):

    """
    Allows the customer to:
    1. Remove an entire item from the cart
    2. Reduce the quantity of an item
    """

    if not order_items:
        print()
        print("Your cart is empty.")
        return order_items

    while True:

        print()
        print("--- Remove an Item ---")

        for index, (item, price, quantity, subtotal) in enumerate(
            order_items,
            start=1
        ):
            print(
                f"{index}. {item} | "
                f"Quantity: {quantity} | "
                f"₦{subtotal:,}"
            )

        print("0. Done")

        try:
            choice = int(
                input(
                    "Choose the item you want to remove/reduce: "
                )
            )

            if choice == 0:
                break

            if choice < 1 or choice > len(order_items):
                print("Please choose a valid item number.")
                continue

            index = choice - 1

            item, price, quantity, subtotal = order_items[index]

            print()
            print(f"Selected: {item}")
            print(f"Current quantity: {quantity}")
            print()
            print("1. Remove the entire item")
            print("2. Reduce quantity")
            print("3. Cancel")

            action = input("Choose an option (1-3): ").strip()

            # ------------------------------------------------
            # Remove entire item
            # ------------------------------------------------

            if action == "1":

                removed_item = order_items.pop(index)

                print()
                print(
                    f"Removed {removed_item[0]} "
                    f"from the cart."
                )

            # ------------------------------------------------
            # Reduce quantity
            # ------------------------------------------------

            elif action == "2":

                if quantity == 1:

                    print(
                        "This item has quantity 1. "
                        "It cannot be reduced further."
                    )

                    continue

                while True:

                    try:

                        reduce_by = int(
                            input(
                                "How many would you like to remove? "
                            )
                        )

                        if reduce_by <= 0:
                            print(
                                "Enter a quantity greater than 0."
                            )
                            continue

                        if reduce_by >= quantity:

                            print(
                                "You cannot remove that many. "
                                "Use option 1 to remove the entire item."
                            )

                            continue

                        new_quantity = quantity - reduce_by

                        new_subtotal = price * new_quantity

                        order_items[index] = (
                            item,
                            price,
                            new_quantity,
                            new_subtotal
                        )

                        print()
                        print(
                            f"Updated {item}: "
                            f"quantity is now {new_quantity}."
                        )

                        break

                    except ValueError:

                        print(
                            "Please enter a valid number."
                        )

            # ------------------------------------------------
            # Cancel
            # ------------------------------------------------

            elif action == "3":

                print("No changes made.")

            else:

                print("Please choose 1, 2, or 3.")

        except ValueError:

            print("Please enter a valid number.")

        # Display updated cart.
        print_cart_so_far(order_items)

    return order_items


# ============================================================
# RECEIPT
# ============================================================

def print_receipt(
    customer_name,
    order_items,
    total,
    payment_method=None,
    payment_status=None,
    reference=None,
    change=None
):

    print()
    print_header()

    print("Customer:", customer_name)

    print("--------------------------------")

    for item, price, quantity, subtotal in order_items:

        print(
            f"{quantity} x {item} @ ₦{price:,} "
            f"= ₦{subtotal:,}"
        )

    print("--------------------------------")

    print(f"TOTAL: ₦{total:,}")

    if payment_method:
        print("Payment Method:", payment_method)

    if payment_status:
        print("Payment Status:", payment_status)

    if reference:
        print("Reference:", reference)

    if change is not None:
        print(f"Change due: ₦{change:,.2f}")

    print("================================")


# ============================================================
# SAVE RECEIPT TO TEXT FILE
# ============================================================

def save_receipt_to_txt(
    customer_name,
    order_items,
    total,
    payment_method,
    payment_status,
    reference=None,
    change=None
):

    """
    Saves the final receipt to a .txt file.
    """

    timestamp = datetime.now().strftime(
        "%Y-%m-%d_%H-%M-%S"
    )

    safe_name = "".join(
        c if c.isalnum() else "_"
        for c in customer_name
    ) or "customer"

    filename = (
        f"receipt_{safe_name}_{timestamp}.txt"
    )

    lines = [

        "================================",
        "       JULIET'S SWEET TREATS",
        "================================",

        f"Date: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",

        f"Customer: {customer_name}",

        "--------------------------------",
    ]

    for item, price, quantity, subtotal in order_items:

        lines.append(
            f"{quantity} x {item} @ ₦{price:,} "
            f"= ₦{subtotal:,}"
        )

    lines += [

        "--------------------------------",

        f"TOTAL: ₦{total:,}",

        f"Payment Method: {payment_method}",

        f"Payment Status: {payment_status}",
    ]

    if reference:

        lines.append(
            f"Reference: {reference}"
        )

    if change is not None:

        lines.append(
            f"Change due: ₦{change:,.2f}"
        )

    lines += [

        "================================",
        "       THANK YOU FOR ORDERING!",
        "================================",
    ]

    with open(
        filename,
        "w",
        encoding="utf-8"
    ) as f:

        f.write(
            "\n".join(lines) + "\n"
        )

    return filename


# ============================================================
# CASH PAYMENT
# ============================================================

def pay_with_cash(total):

    """
    Calculates change owed for cash payment.
    """

    while True:

        try:

            amount_given = float(
                input(
                    f"Total due is ₦{total:,}. "
                    f"Enter amount received from customer: ₦"
                )
            )

        except ValueError:

            print("Please enter a valid amount.")

            continue

        if amount_given < total:

            shortfall = total - amount_given

            print(
                f"That's ₦{shortfall:,.2f} "
                f"short of the total."
            )

            print(
                "Please collect the remaining amount."
            )

            continue

        change = amount_given - total

        if change > 0:

            print(
                f"Change due to customer: "
                f"₦{change:,.2f}"
            )

            return "PAID", None, change

        else:

            print(
                "Exact amount received — "
                "no change due."
            )

            return "PAID", None, None


