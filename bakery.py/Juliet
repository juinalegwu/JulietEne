# CARD PAYMENT
# ============================================================

def pay_with_card(total):

    """
    Simulates a card terminal flow.
    """

    print()

    print("Card payment selected.")

    print(
        f"Please process ₦{total:,} "
        f"on the physical card terminal (POS)."
    )

    input(
        "Press Enter once the terminal "
        "shows APPROVED... "
    )

    confirmed = input(
        "Did the terminal print an APPROVED "
        "receipt? (yes/no): "
    ).strip().lower()

    if confirmed == "yes":

        return "PAID", None, None

    else:

        return (
            "DECLINED — try another payment method",
            None,
            None
        )


# ============================================================
# CHOOSE PAYMENT METHOD
# ============================================================

def choose_payment_method(total):

    print()

    print("Payment Methods")

    print("1. Cash")
    print("2. Bank Transfer")
    print("3. Card")

    while True:

        try:

            choice = int(
                input(
                    "Choose payment method (1-3): "
                )
            )

        except ValueError:

            print(
                "Please enter a valid number."
            )

            continue

        # Cash
        if choice == 1:

            status, reference, change = (
                pay_with_cash(total)
            )

            return (
                "Cash",
                status,
                reference,
                change
            )

        # Bank transfer
        elif choice == 2:

            status, reference, change = (
                pay_with_transfer(total)
            )

            return (
                "Bank Transfer",
                status,
                reference,
                change
            )

        # Card
        elif choice == 3:

            status, reference, change = (
                pay_with_card(total)
            )

            return (
                "Card",
                status,
                reference,
                change
            )

        else:

            print(
                "Please choose 1, 2, or 3."
            )


# ============================================================
# MAIN PROGRAM
# ============================================================

def main():

    print_header()

    print()

    customer_name = input(
        "Enter customer name: "
    ).strip()

    # --------------------------------------------------------
    # Build the order
    # --------------------------------------------------------

    order_items = build_order()

    # --------------------------------------------------------
    # Ask whether customer wants to remove anything
    # --------------------------------------------------------

    while True:

        print()

        print("Order Options")

        print("1. Continue to payment")
        print("2. Remove/reduce an item")
        print("3. View cart")

        option = input(
            "Choose an option (1-3): "
        ).strip()

        if option == "1":

            break

        elif option == "2":

            order_items = remove_item(
                order_items
            )

            # If customer removed everything,
            # send them back to adding items.
            if not order_items:

                print()
                print(
                    "Your cart is empty."
                )

                print(
                    "Please add an item."
                )

                order_items = build_order()

        elif option == "3":

            print_cart_so_far(
                order_items
            )

        else:

            print(
                "Please choose 1, 2, or 3."
            )

    # --------------------------------------------------------
    # Calculate total
    # --------------------------------------------------------

    total = sum(
        subtotal
        for _, _, _, subtotal in order_items
    )

    # --------------------------------------------------------
    # Show order before payment
    # --------------------------------------------------------

    print()
    print("--- FINAL ORDER ---")

    print_cart_so_far(
        order_items
    )

    # --------------------------------------------------------
    # Payment
    # --------------------------------------------------------

    payment_method, payment_status, reference, change = (
        choose_payment_method(total)
    )

    # --------------------------------------------------------
    # Final receipt
    # --------------------------------------------------------

    print_receipt(
        customer_name,
        order_items,
        total,
        payment_method,
        payment_status,
        reference,
        change
    )

    print()
    print(
        "       THANK YOU FOR ORDERING!"
    )

    print(
        "================================"
    )

    # --------------------------------------------------------
    # Save receipt
    # --------------------------------------------------------

    filename = save_receipt_to_txt(
        customer_name,
        order_items,
        total,
        payment_git config --global user.email "you@example.com"
  git config --global user.name "Your Name"method,
        payment_status,
        reference,
        change
    )

    print()

    print(
        f"Receipt saved to: {filename}"
    )


# ============================================================
# START PROGRAM
# ============================================================

if __name__ == "__main__":
    main()
